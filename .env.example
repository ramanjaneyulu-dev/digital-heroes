# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=            # server only, bypasses RLS: never expose

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments: "stripe" (Stripe Checkout, test mode) or "demo" (built-in test gateway) ---
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=              # sk_test_...  (server only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_... (hosted Checkout does not need it; kept for future client-side use)
STRIPE_WEBHOOK_SECRET=          # whsec_...  (server only, from the webhook endpoint or `stripe listen`)
